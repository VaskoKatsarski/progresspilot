# Anthropic API key (used by server.js and agent.js)
CLAUDE_API_KEY=

# Notion integration token, and the IDs of the two databases it can access
NOTION_API_KEY=
DAILY_LOGS_DB=
WEEKLY_SUMMARY_DB=

# ElevenLabs API key (text-to-speech for the voice page)
ELEVENLABS_API_KEY=

# Gmail account used to send the weekly summary email (agent.js).
# SMTP_PASS must be a Google "app password", not your normal account password.
SMTP_USER=
SMTP_PASS=
# Optional: where to send the summary. Defaults to SMTP_USER.
MAIL_TO=

# Optional: port for the web server (defaults to 3000)
PORT=3000
